---
/* 8 EEG channels, motor channels highlighted. Deterministic (seeded) so it is
   identical on every build. Over C3/Cz/C4 the mu rhythm drops in the shaded
   window: the event-related desynchronisation motor-imagery BCIs detect. */
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const channels = ["Fp1", "F3", "C3", "Cz", "C4", "P3", "O1", "O2"];
const picked = new Set(["C3", "Cz", "C4"]);
const W = 1200, X0 = 52, TOP = 26, GAP = 34, N = 440;
const WIN = [600, 880];
const smooth = (e0, e1, x) => { const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0))); return t * t * (3 - 2 * t); };
const traces = channels.map((name, i) => {
  const y0 = TOP + i * GAP;
  const ph = [rnd() * 6.28, rnd() * 6.28, rnd() * 6.28];
  const f = [0.36 + rnd() * 0.04, 0.06 + rnd() * 0.02, 0.9 + rnd() * 0.2];
  let n = 0, d = "";
  for (let k = 0; k <= N; k++) {
    const x = X0 + (W - X0 - 6) * k / N;
    n = 0.7 * n + 0.3 * (rnd() - 0.5);
    let mu = Math.sin(k * f[0] + ph[0]);
    if (picked.has(name)) mu *= 1 - 0.75 * smooth(WIN[0] - 30, WIN[0] + 20, x) * (1 - smooth(WIN[1] - 20, WIN[1] + 30, x));
    const v = 7 * mu + 3.5 * Math.sin(k * f[1] + ph[1]) + 1.2 * Math.sin(k * f[2] + ph[2]) + 10 * n;
    d += (k ? "L" : "M") + x.toFixed(1) + " " + (y0 + v).toFixed(1);
  }
  return { name, y0, d, picked: picked.has(name) };
});
const H = TOP + GAP * (channels.length - 1) + 30;
---
<figure class="eeg wrap" aria-labelledby="eeg-caption">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Eight EEG channels. During the shaded window the rhythm over channels C3, Cz and C4 weakens.">
    <rect class="eeg-window" x={WIN[0]} y="4" width={WIN[1] - WIN[0]} height={H - 8} rx="3" />
    <text class="eeg-window-label" x={WIN[0] + 10} y={H - 12}>imagined hand movement</text>
    {traces.map((t, i) => (
      <g class={t.picked ? "ch picked" : "ch"} style={`--i:${i}`}>
        <text x="0" y={t.y0 + 4}>{t.name}</text>
        <path d={t.d} pathLength="1" />
      </g>
    ))}
  </svg>
  <figcaption id="eeg-caption">Out of many EEG electrodes, only a few carry the signal you need. Over the motor cortex (C3, Cz, C4) the rhythm weakens when a person imagines moving a hand. Finding those few channels automatically was the subject of my PhD.</figcaption>
</figure>
