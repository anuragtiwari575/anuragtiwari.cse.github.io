---
import BaseLayout from "../layouts/BaseLayout.astro";
const research = [
  { title: "AI for Medical Imaging", text: "Learning-based methods for medical image analysis, reconstruction and clinically relevant decision support.", tag: "MEDICAL AI" },
  { title: "Computational Neuroscience", text: "Data-driven modelling of neural signals, brain dynamics and neurological conditions.", tag: "NEUROSCIENCE" },
  { title: "Brain–Computer Interfaces", text: "EEG-based motor imagery, neural decoding and multimodal brain-signal analysis.", tag: "BCI & EEG" },
  { title: "Trustworthy Machine Learning", text: "Robust, interpretable and reliable learning systems for high-impact applications.", tag: "MACHINE LEARNING" }
];
const highlights = [
  { n: "01", title: "Research", text: "Research themes, current directions and ongoing work." },
  { n: "02", title: "Publications", text: "Peer-reviewed papers with DOI, code and supplementary resources." },
  { n: "03", title: "Open research", text: "Reproducible implementations, datasets and research artefacts." },
  { n: "04", title: "Opportunities", text: "PhD recruitment, student projects and collaboration interests." }
];
---
<BaseLayout>
  <header class="topbar">
    <a class="brand" href="#home">AT<span>.</span></a>
    <nav>
      <a href="#about">About</a><a href="#research">Research</a><a href="#publications">Publications</a><a href="#open-research">Open Research</a><a href="#opportunities">Opportunities</a><a href="#contact">Contact</a>
    </nav>
    <a class="nav-cta" href="#contact">Get in touch <span>↗</span></a>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="hero-image"></div>
      <div class="hero-shade"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> ACADEMIC PROFILE · RESEARCH · OPEN SCIENCE</p>
          <h1>Dr. Anurag<br/><em>Tiwari</em></h1>
          <p class="role">Assistant Professor · Department of Computer Science and Engineering</p>
          <p class="affiliation">South Asian University · New Delhi, India</p>
          <p class="intro">Research at the intersection of artificial intelligence, computational neuroscience and medical imaging, with an emphasis on rigorous methods and reproducible science.</p>
          <div class="hero-actions">
            <a class="button light" href="#publications">Explore research <span>↗</span></a>
            <a class="text-link" href="#about">Academic profile <span>↓</span></a>
          </div>
          <div class="socials">
            <a href="https://scholar.google.com/citations?user=HLtrjaMAAAAJ&amp;hl=en" target="_blank" rel="noreferrer">Google Scholar ↗</a>
            <a href="https://orcid.org/" target="_blank" rel="noreferrer">ORCID ↗</a>
            <a href="https://github.com/anuragtiwari575" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href="mailto:anuragtiwari@sau.int">Email ↗</a>
          </div>
        </div>
        <div class="portrait-wrap">
          <div class="portrait-frame"><img src={`${import.meta.env.BASE_URL}images/profile-outdoor.jpeg`} alt="Portrait of Dr. Anurag Tiwari" /></div>
          <div class="portrait-caption"><span class="caption-dot"></span><span>FACULTY · RESEARCHER · EDUCATOR</span></div>
        </div>
        <div class="hero-index">01 <span>/</span> 04</div>
      </div>
      <div class="hero-bottom"><span>SCROLL TO EXPLORE</span><span class="scroll-line"></span><span>NEW DELHI, INDIA</span></div>
    </section>

    <section class="intro-strip" id="about">
      <div class="section-label">01 / ABOUT</div>
      <div class="intro-grid">
        <h2>Curiosity-led research.<br/><em>Impact-oriented outcomes.</em></h2>
        <div class="about-copy">
          <p>I am Dr. Anurag Tiwari, Assistant Professor in the Department of Computer Science and Engineering at South Asian University, New Delhi, India. My work explores computational approaches to complex problems in healthcare, neuroscience and intelligent systems.</p>
          <p>This website brings together my academic profile, selected publications, research projects, open-source implementations, teaching activities and opportunities for research collaboration.</p>
          <a class="under-link" href="#contact">Connect for research collaboration <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="research-section" id="research">
      <div class="section-head">
        <div><div class="section-label">02 / RESEARCH DIRECTIONS</div><h2>Questions that<br/><em>move research forward.</em></h2></div>
        <p>Interdisciplinary research grounded in computational methods, careful evaluation and meaningful scientific questions.</p>
      </div>
      <div class="research-grid">
        {research.map((r, i) => <article class="research-card"><div class="card-top"><span>{r.tag}</span><span>0{i+1}</span></div><h3>{r.title}</h3><p>{r.text}</p><a href="#contact" aria-label={`Discuss ${r.title}`}>Explore direction <span>↗</span></a></article>)}
      </div>
    </section>

    <section class="publication-section" id="publications">
      <div class="section-head">
        <div><div class="section-label">03 / SELECTED SCHOLARSHIP</div><h2>Research in<br/><em>the public record.</em></h2></div>
        <p>Publication records will link each paper to its DOI, authorised full text, source code and associated datasets.</p>
      </div>
      <div class="publication-placeholder">
        <div class="pub-symbol">↗</div>
        <div><span class="mini-label">PUBLICATION LIBRARY</span><h3>Selected publications are being organised.</h3><p>Verified bibliographic records will be added here. Each paper will have a dedicated page with its abstract, methods, resources and implementation links.</p></div>
        <a class="button dark" href="/anuragtiwari.cse.github.io/publications/">View publication catalogue <span>↗</span></a>
      </div>
    </section>

    <section class="open-section" id="open-research">
      <div class="open-copy"><div class="section-label">04 / OPEN RESEARCH</div><h2>From published ideas<br/>to <em>reproducible work.</em></h2><p>Research code, experiment configurations, documentation and permitted datasets will be organised alongside their corresponding publications.</p><a class="button light" href="https://github.com/anuragtiwari575" target="_blank" rel="noreferrer">Explore GitHub repositories <span>↗</span></a></div>
      <div class="open-visual"><div class="code-window"><div class="window-bar"><i></i><i></i><i></i><span>research-project / README.md</span></div><pre><span class="code-muted"># Research artefact</span>
project/
  ├── paper/
  ├── src/
  ├── configs/
  ├── experiments/
  ├── results/
  └── README.md

<span class="code-green"># Reproducibility first</span>
environment.yml
requirements.txt
LICENSE</pre></div><div class="visual-note">PAPER · CODE · DATA · RESULTS</div></div>
    </section>

    <section class="opportunities-section" id="opportunities">
      <div class="section-label">05 / STUDENTS &amp; COLLABORATION</div>
      <div class="opportunity-grid">
        <div><h2>Build something<br/><em>meaningful.</em></h2><p>I welcome conversations with motivated students and researchers interested in interdisciplinary work across AI, healthcare and computational neuroscience.</p></div>
        <div class="opportunity-panel"><span class="mini-label">RESEARCH OPPORTUNITIES</span><h3>Prospective PhD scholars</h3><p>Information about available positions, research themes, eligibility and application procedures will be posted here when recruitment is open.</p><span class="status"><i></i> Opportunities announced periodically</span><a class="under-link" href="mailto:anuragtiwari@sau.int?subject=Research%20interest">Express research interest <span>↗</span></a></div>
      </div>
    </section>

    <section class="profile-section">
      <div class="profile-photo"><img src={`${import.meta.env.BASE_URL}images/profile-conference.jpeg`} alt="Dr. Anurag Tiwari at an academic conference" /></div>
      <div class="profile-text"><div class="section-label">06 / ACADEMIC LIFE</div><h2>Research is a<br/><em>collaborative pursuit.</em></h2><p>Beyond research publications, this space will document academic engagements, invited talks, workshops, teaching, student mentorship and community contributions.</p><a class="under-link" href="#contact">Academic enquiries <span>↗</span></a></div>
    </section>

    <section class="contact-section" id="contact">
      <div class="section-label">07 / CONTACT</div>
      <h2>Have a research question<br/>or an idea to <em>explore?</em></h2>
      <p>For research collaboration, prospective student enquiries, academic invitations and scholarly communication. Email: anuragtiwari@sau.int or anuragtiwari@gmail.com.</p>
      <a class="button light" href="mailto:anuragtiwari@sau.int">Write an email <span>↗</span></a>
      <div class="contact-meta"><span>South Asian University</span><span>New Delhi, India</span><span>Academic website · 2026</span></div>
    </section>
  </main>
  <footer><a class="brand" href="#home">AT<span>.</span></a><span>Research · Education · Open Science</span><a href="#home">Back to top ↑</a></footer>
</BaseLayout>