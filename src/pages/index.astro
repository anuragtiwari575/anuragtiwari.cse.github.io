---
import BaseLayout from "../layouts/BaseLayout.astro";
import EegBand from "../components/EegBand.astro";
import { publications, themes } from "../data/publications.js";
import { news } from "../data/news.js";
import { profile, bio, research } from "../data/site.js";
import { url, linkFor, boldAuthor } from "../lib.js";

const latest = news.slice(0, 3);
const selected = publications.filter((p) => p.featured).slice(0, 5);
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>{profile.name}</h1>
      <p class="lede">{profile.lede}</p>
      <p class="post">{profile.title}<br />{profile.institution}</p>
      <ul class="links">
        <li><a href={profile.scholar}>Google Scholar</a></li>
        <li><a href={profile.orcid}>ORCID</a></li>
        <li><a href={profile.github}>GitHub</a></li>
        <li><a href={`mailto:${profile.emails[0]}`}>{profile.emails[0]}</a></li>
        {profile.cvPdf && <li><a href={url(profile.cvPdf)}>CV (PDF)</a></li>}
      </ul>
    </div>
    <figure class="portrait">
      <img src={url("images/profile-snow.jpg")} alt={profile.name} width="900" height="900" />
    </figure>
  </section>

  <EegBand />

  <section class="block wrap home-grid">
    <div>
      <h2>About</h2>
      <div class="prose">{bio.map((p) => <p>{p}</p>)}</div>
    </div>
    <aside>
      <div class="block-head"><h2>Latest news</h2><a class="more" href={url("news/")}>All news</a></div>
      <ol class="news compact">
        {latest.map((n) => <li><time>{n.date}</time><p set:html={n.text} /></li>)}
      </ol>
    </aside>
  </section>

  <section class="block wrap">
    <div class="block-head"><h2>Research</h2><a class="more" href={url("research/")}>Research in detail</a></div>
    <ul class="glance">
      {research.map((r) => (
        <li><a href={url(`research/#${r.key}`)}>{themes[r.key]}</a><p>{r.short}</p></li>
      ))}
    </ul>
  </section>

  <section class="block wrap">
    <div class="block-head"><h2>Selected publications</h2><a class="more" href={url("publications/")}>All {publications.length} publications</a></div>
    <p class="section-intro">{profile.metrics}</p>
    <ol class="pubs">
      {selected.map((p) => (
        <li class="pub">
          <span class="pub-year">{p.year}</span>
          <div>
            <a class="pub-title" href={linkFor(p)}>{p.title}</a>
            <p class="pub-authors" set:html={boldAuthor(p.authors)} />
            <p class="pub-venue">{p.venue}{p.status === "accepted" && <span class="tag">Accepted</span>}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
