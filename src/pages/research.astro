---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publications, themes } from "../data/publications.js";
import { research } from "../data/site.js";
import { url, linkFor } from "../lib.js";

const items = research.map((r) => ({ ...r, title: themes[r.key], papers: publications.filter((p) => p.theme === r.key) }));
---
<BaseLayout title="Research — Anurag Tiwari" heading="Research">
  <p slot="intro">One question runs through most of this work: when a model reports a good number on biological data, how much of it will survive a new subject, a new scanner or a new cohort?</p>
  <div class="wrap">
    <nav class="toc" aria-label="Research themes">
      {items.map((r) => <a href={`#${r.key}`}>{r.title}</a>)}
    </nav>
    <div class="themes">
      {items.map((r) => (
        <article class="theme" id={r.key}>
          <h2 class="theme-title">{r.title}</h2>
          <p>{r.text}</p>
          <ul class="theme-papers">
            {r.papers.map((p) => (
              <li><a href={linkFor(p)}>{p.title}</a> <span class="venue-year">{p.status === "accepted" ? "accepted, " : ""}{p.year}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="section-intro after"><a href={url("publications/")}>Search all publications</a> by theme, type or year.</p>
  </div>
</BaseLayout>
