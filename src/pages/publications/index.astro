---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publications, themes } from "../../data/publications.js";

const scholarSearch = (t) => `https://scholar.google.com/scholar?q=${encodeURIComponent(`"${t}"`)}`;
const bold = (authors) => authors.replace(/A\. Tiwari/g, "<strong>A. Tiwari</strong>");
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const types = [...new Set(publications.map((p) => p.type))];
const byYear = years.map((y) => ({ year: y, items: publications.filter((p) => p.year === y) }));
---
<BaseLayout title="Publications — Anurag Tiwari" description="Journal articles, conference papers and book chapters by Dr. Anurag Tiwari, South Asian University.">
  <div class="wrap">
    <header class="page-head">
      <h1>Publications</h1>
      <p>{publications.length} papers on brain signals, medical imaging, feature selection and biological data. Each title links to the paper, or to a Google Scholar search where no direct link has been added yet.</p>
    </header>

    <div class="filters">
      <input id="q" type="search" placeholder="Search titles, authors or venues" aria-label="Search publications" />
      <select id="theme" aria-label="Filter by research theme">
        <option value="all">All themes</option>
        {Object.entries(themes).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
      <select id="type" aria-label="Filter by publication type">
        <option value="all">All types</option>
        {types.map((t) => <option value={t}>{t}</option>)}
      </select>
      <select id="year" aria-label="Filter by year">
        <option value="all">All years</option>
        {years.map((y) => <option value={y}>{y}</option>)}
      </select>
    </div>
    <p class="count" id="count" aria-live="polite">Showing all {publications.length}</p>

    {byYear.map((g) => (
      <section class="year-group" data-year={g.year}>
        <h2>{g.year}</h2>
        <ol class="pubs">
          {g.items.map((p) => (
            <li class="pub" data-search={`${p.title} ${p.authors} ${p.venue}`.toLowerCase()} data-type={p.type} data-theme={p.theme}>
              <div>
                <a class="pub-title" href={p.doi ? `https://doi.org/${p.doi}` : (p.pdf || scholarSearch(p.title))}>{p.title}</a>
                <p class="pub-authors" set:html={bold(p.authors)} />
                <p class="pub-venue">{p.venue}{p.status === "accepted" && <span class="tag">Accepted</span>}</p>
                <p class="pub-meta">{p.type}, {themes[p.theme]}</p>
                {(p.code || p.pdf || p.doi) && (
                  <p class="pub-links">
                    {p.doi && <a href={`https://doi.org/${p.doi}`}>DOI</a>}
                    {p.pdf && <a href={p.pdf}>PDF</a>}
                    {p.code && <a href={p.code}>Code</a>}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <p class="empty" id="empty" hidden>No papers match these filters. Clear the search box or set the filters back to "All".</p>
  </div>

  <script>
    const q = document.getElementById("q");
    const theme = document.getElementById("theme");
    const type = document.getElementById("type");
    const year = document.getElementById("year");
    const count = document.getElementById("count");
    const empty = document.getElementById("empty");
    const groups = [...document.querySelectorAll(".year-group")];
    const total = document.querySelectorAll(".pub").length;

    function apply() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const g of groups) {
        let inGroup = 0;
        const yearOk = year.value === "all" || g.dataset.year === year.value;
        for (const li of g.querySelectorAll(".pub")) {
          const ok = yearOk
            && (!term || li.dataset.search.includes(term))
            && (theme.value === "all" || li.dataset.theme === theme.value)
            && (type.value === "all" || li.dataset.type === type.value);
          li.hidden = !ok;
          if (ok) inGroup++;
        }
        g.hidden = inGroup === 0;
        shown += inGroup;
      }
      count.textContent = shown === total ? `Showing all ${total}` : `Showing ${shown} of ${total}`;
      empty.hidden = shown !== 0;
    }
    [q, theme, type, year].forEach((el) => el.addEventListener("input", apply));
  </script>
</BaseLayout>
