---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Page not found — Anurag Tiwari">
  <div class="wrap page-head" style="min-height:55vh">
    <h1>Page not found</h1>
    <p>This address doesn’t match any page on the site. It may have moved when the site was reorganised.</p>
    <p><a href={`${base}/`}>Go to the homepage</a> or <a href={`${base}/publications/`}>browse publications</a>.</p>
  </div>
</BaseLayout>
